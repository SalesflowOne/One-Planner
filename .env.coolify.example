# Copy these values into the Coolify environment for docker-compose.coolify.yml.
# Do not commit a filled-in .env file with real secrets.

# Public URL assigned to the proxy service in Coolify, without a trailing slash.
PLANE_PUBLIC_URL=https://plane.example.com

# Required secrets. Generate unique values for each deployment.
SECRET_KEY=change-me-generate-a-long-random-django-secret
POSTGRES_PASSWORD=change-me-postgres-password
RABBITMQ_PASSWORD=change-me-rabbitmq-password
AWS_ACCESS_KEY_ID=change-me-minio-access-key
AWS_SECRET_ACCESS_KEY=change-me-minio-secret-key
LIVE_SERVER_SECRET_KEY=change-me-live-server-secret

# Optional database/broker names and users.
POSTGRES_USER=plane
POSTGRES_DB=plane
RABBITMQ_USER=plane
RABBITMQ_VHOST=plane

# Built-in MinIO storage defaults.
AWS_REGION=
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

# Plane auth defaults for first setup.
ENABLE_SIGNUP=1
ENABLE_EMAIL_PASSWORD=1
ENABLE_MAGIC_LINK_LOGIN=0

# Runtime tuning.
GUNICORN_WORKERS=2
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT=60/minute

# Public metadata used by frontend builds.
PLANE_WEBSITE_URL=https://plane.so
PLANE_SUPPORT_EMAIL=support@plane.so

# SMTP is optional. Keep disabled until real mail credentials are configured.
ENABLE_SMTP=0
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_FROM=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# Optional OAuth/integration credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORGANIZATION_ID=
GITLAB_HOST=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
IS_GITEA_ENABLED=0
GITEA_HOST=
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=

# Optional AI/Unsplash integrations.
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
GPT_ENGINE=gpt-3.5-turbo
UNSPLASH_ACCESS_KEY=
